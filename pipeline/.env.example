SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
CATEGORY_BATCH_SIZE=5
KNOWLEDGE_BATCH_SIZE=10
QUESTIONS_BATCH_SIZE=20

# Optional knobs (defaults shown; generation runs through `claude -p`, no API key needed)
# ENABLE_CATEGORY_AGENT=false     # set 1/true to let the run create new categories
# USAGE_SHARE=0.7                 # fraction of each night's share of weekly headroom to spend
# USAGE_WEEKLY_CEILING=95         # never push weekly usage past this percent
# USAGE_FIVE_HOUR_CEILING=50      # stop when the 5-hour window reaches this percent
# USAGE_FIVE_HOUR_CEILING_LATE=30 # same, when that window is still live past RUN_LATE_CUTOFF_LOCAL
# RUN_DEADLINE_LOCAL=06:30        # local HH:MM the run must finish by
# RUN_LATE_CUTOFF_LOCAL=07:00     # local HH:MM after which a live 5-hour window uses the late ceiling
# RUN_MAX_HOURS=10                # refuse to start when the deadline is further away than this
# MAX_CYCLES=30                   # backstop: stop after this many generate/verify cycles
# USAGE_STUCK_USD=0               # >0: stop ("usage not moving") when this much notional cost passes with no change in weekly usage; 0 = off
# STALE_RUN_MS=25200000           # a 'running' pipeline_runs row older than this is treated as dead (default 7 h)
# PIPELINE_YIELD_CMD=             # optional command run before each model call: exit 0 go, 1 wait, 2 stop
# RUN_SUMMARY_FILE=               # optional path; a JSON summary of the run is written here
